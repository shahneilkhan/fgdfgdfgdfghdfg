<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Shah Neil Khan | Software & Context Engineer</title>

  <meta
    name="description"
    content="Portfolio of Shah Neil Khan — Software Engineer and Context Engineer."
  />

  <link rel="stylesheet" href="style.css" />

  <!-- Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
</head>

<body>

  <!-- Background -->
  <div class="background">
    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>
    <div class="grid"></div>
  </div>

  <!-- Navigation -->
  <nav class="navbar container">
    <a href="#home" class="logo">
      SHAH<span>.</span>
    </a>

    <div class="nav-links" id="navLinks">
      <a href="#about">About</a>
      <a href="#skills">Skills</a>
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </div>

    <button class="menu-btn" id="menuBtn" aria-label="Menu">
      ☰
    </button>
  </nav>


  <main>

    <!-- HERO -->
    <section id="home" class="hero container">

      <div class="hero-content">

        <div class="availability">
          <span></span>
          Available for opportunities
        </div>

        <p class="intro">Hello, I'm</p>

        <h1>
          Shah Neil
          <span>Khan.</span>
        </h1>

        <h2>
          Software Engineer
          <br />
          <span>& Context Engineer</span>
        </h2>

        <p class="hero-description">
          I build scalable software, intelligent systems, and
          AI-powered experiences with a strong focus on context,
          architecture, and meaningful user interactions.
        </p>

        <div class="hero-buttons">
          <a href="#projects" class="btn primary-btn">
            Explore My Work
            <span>↗</span>
          </a>

          <a href="#contact" class="btn secondary-btn">
            Let's Talk
          </a>
        </div>

      </div>


      <!-- Hero Card -->
      <div class="hero-visual">

        <div class="code-card glass">

          <div class="card-header">
            <div class="dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <p>context.engineer.js</p>
          </div>

          <pre><code><span class="purple">const</span> engineer = {

  name:
    <span class="green">"Shah Neil Khan"</span>,

  role:
    <span class="green">"Software & Context Engineer"</span>,

  passion: [
    <span class="green">"Software"</span>,
    <span class="green">"AI"</span>,
    <span class="green">"LLMs"</span>
  ],

  mission: () =>
    <span class="green">"Build meaningful systems"</span>
};

<span class="blue">engineer</span>.create();
</code></pre>

        </div>

        <div class="floating-tag tag-one">
          <span>⚡</span> Software
        </div>

        <div class="floating-tag tag-two">
          <span>✦</span> AI Systems
        </div>

      </div>

    </section>


    <!-- ABOUT -->
    <section id="about" class="section container">

      <div class="section-label">
        <span>01.</span> ABOUT ME
      </div>

      <div class="about-grid">

        <div class="about-main">
          <h2>
            Building software with
            <span>intelligence & purpose.</span>
          </h2>
        </div>

        <div class="about-text">
          <p>
            I'm a Software Engineer and Context Engineer focused on
            creating modern digital products and intelligent systems.
          </p>

          <p>
            I enjoy working at the intersection of software engineering,
            AI, context design, and user experience.
          </p>

          <a href="#contact" class="text-link">
            Let's work together →
          </a>
        </div>

      </div>

    </section>


    <!-- EXPERTISE -->
    <section class="section container">

      <div class="section-label">
        <span>02.</span> WHAT I DO
      </div>

      <div class="expertise-grid">

        <article class="expertise-card glass">
          <div class="card-number">01</div>
          <div class="expertise-icon">⌘</div>

          <h3>Software Engineering</h3>

          <p>
            Designing and building scalable, reliable, and
            user-focused software applications.
          </p>
        </article>


        <article class="expertise-card glass">
          <div class="card-number">02</div>
          <div class="expertise-icon">◉</div>

          <h3>Context Engineering</h3>

          <p>
            Designing context-aware systems that help AI models
            understand information and generate better results.
          </p>
        </article>


        <article class="expertise-card glass">
          <div class="card-number">03</div>
          <div class="expertise-icon">✦</div>

          <h3>AI & LLM Systems</h3>

          <p>
            Exploring intelligent applications, LLM workflows,
            knowledge systems, and AI-powered experiences.
          </p>
        </article>

      </div>

    </section>


    <!-- SKILLS -->
    <section id="skills" class="section container">

      <div class="section-label">
        <span>03.</span> TECHNOLOGIES
      </div>

      <div class="skills-wrapper">

        <div class="skills-intro">
          <h2>
            Tools I use to
            <span>build things.</span>
          </h2>

          <p>
            Continuously learning, experimenting, and building with
            modern technologies.
          </p>
        </div>

        <div class="skills-list">

          <div class="skill glass">JavaScript</div>
          <div class="skill glass">Python</div>
          <div class="skill glass">HTML5</div>
          <div class="skill glass">CSS3</div>
          <div class="skill glass">React</div>
          <div class="skill glass">Node.js</div>
          <div class="skill glass">Git</div>
          <div class="skill glass">GitHub</div>
          <div class="skill glass">APIs</div>
          <div class="skill glass">AI</div>
          <div class="skill glass">LLMs</div>
          <div class="skill glass">Context Engineering</div>

        </div>

      </div>

    </section>


    <!-- PROJECTS -->
    <section id="projects" class="section container">

      <div class="projects-heading">

        <div>
          <div class="section-label">
            <span>04.</span> FEATURED WORK
          </div>

          <h2>
            Selected
            <span>projects.</span>
          </h2>
        </div>

        <p>
          A selection of projects and experiments.
          More projects will be added soon.
        </p>

      </div>


      <div class="projects-grid">

        <!-- Project 1 -->
        <article class="project-card glass">

          <div class="project-top">
            <span>PROJECT 01</span>
            <a href="#" aria-label="Project link">↗</a>
          </div>

          <div class="project-icon">✦</div>

          <h3>AI Context Assistant</h3>

          <p>
            An intelligent assistant designed to work with structured
            context and deliver more relevant responses.
          </p>

          <div class="project-stack">
            <span>AI</span>
            <span>LLM</span>
            <span>JavaScript</span>
          </div>

        </article>


        <!-- Project 2 -->
        <article class="project-card glass">

          <div class="project-top">
            <span>PROJECT 02</span>
            <a href="#" aria-label="Project link">↗</a>
          </div>

          <div class="project-icon">⌘</div>

          <h3>Software Platform</h3>

          <p>
            A modern web application focused on clean architecture,
            usability, and scalable development.
          </p>

          <div class="project-stack">
            <span>HTML</span>
            <span>CSS</span>
            <span>JavaScript</span>
          </div>

        </article>


        <!-- Project 3 -->
        <article class="project-card glass">

          <div class="project-top">
            <span>PROJECT 03</span>
            <a href="#" aria-label="Project link">↗</a>
          </div>

          <div class="project-icon">◉</div>

          <h3>Knowledge System</h3>

          <p>
            An experiment exploring information organization,
            retrieval, context, and intelligent workflows.
          </p>

          <div class="project-stack">
            <span>Python</span>
            <span>AI</span>
            <span>API</span>
          </div>

        </article>

      </div>

    </section>


    <!-- CONTACT -->
    <section id="contact" class="contact-section container">

      <div class="contact-card glass">

        <p class="contact-label">05. GET IN TOUCH</p>

        <h2>
          Have an idea?
          <br />
          <span>Let's build it.</span>
        </h2>

        <p>
          I'm always interested in new ideas, interesting problems,
          and opportunities to create meaningful technology.
        </p>

        <a href="mailto:your-email@example.com" class="btn primary-btn">
          Say Hello
          <span>↗</span>
        </a>

      </div>

    </section>

  </main>


  <!-- FOOTER -->
  <footer class="footer container">

    <a href="#home" class="logo">
      SHAH<span>.</span>
    </a>

    <p>
      © <span id="year"></span> Shah Neil Khan.
      Built with curiosity and code.
    </p>

    <div class="social-links">
      <a href="#" target="_blank">GitHub</a>
      <a href="#" target="_blank">LinkedIn</a>
    </div>

  </footer>


  <script src="script.js"></script>

</body>
</html>
